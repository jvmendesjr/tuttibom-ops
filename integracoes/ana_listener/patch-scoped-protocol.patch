 # ---------------------------------------------------------------- db
+def _tabela_existe(conn, nome):
+    return conn.execute(
+        "SELECT 1 FROM sqlite_master WHERE type='table' AND name=?",
+        (nome,),
+    ).fetchone() is not None
+
+
+def _colunas(conn, nome):
+    return {row[1] for row in conn.execute(f"PRAGMA table_info({nome})")}
+
+
+def _tem_unicidade_por_inbox(conn, nome):
+    for indice in conn.execute(f"PRAGMA index_list({nome})").fetchall():
+        if not indice[2]:
+            continue
+        seguro = str(indice[1]).replace('"', '""')
+        colunas = [
+            row[2] for row in conn.execute(f'PRAGMA index_info("{seguro}")')
+        ]
+        if colunas in (["inbox_id", "message_id"], ["message_id", "inbox_id"]):
+            return True
+    return False
+
+
+def _inbox_unico_do_evento(conn, message_id):
+    correspondencias = conn.execute(
+        "SELECT inbox_id FROM events WHERE message_id=? LIMIT 2",
+        (message_id,),
+    ).fetchall()
+    if len(correspondencias) != 1 or correspondencias[0][0] is None:
+        raise RuntimeError("cumprimento_inbox_indeterminado")
+    return correspondencias[0][0]
+
+
+def _migrar_schema(conn):
+    if not _tabela_existe(conn, "events"):
+        conn.execute(
+            "CREATE TABLE events("
+            "message_id INTEGER, conversation_id INTEGER,"
+            " inbox_id INTEGER, contato_ref TEXT, handoff TEXT,"
+            " recebido_em TEXT, estado TEXT DEFAULT 'pendente'"
+            " CHECK (estado IN ('pendente','entregue','ignorado')),"
+            " UNIQUE(inbox_id, message_id))"
+        )
+    elif not _tem_unicidade_por_inbox(conn, "events"):
+        duplicado = conn.execute(
+            "SELECT 1 FROM events GROUP BY inbox_id, message_id"
+            " HAVING COUNT(*) > 1 LIMIT 1"
+        ).fetchone()
+        if duplicado is not None:
+            raise RuntimeError("evento_inbox_duplicado")
+        conn.execute(
+            "CREATE TABLE events_migracao_v2("
+            "message_id INTEGER, conversation_id INTEGER,"
+            " inbox_id INTEGER, contato_ref TEXT, handoff TEXT,"
+            " recebido_em TEXT, estado TEXT DEFAULT 'pendente'"
+            " CHECK (estado IN ('pendente','entregue','ignorado')),"
+            " UNIQUE(inbox_id, message_id))"
+        )
+        conn.execute(
+            "INSERT INTO events_migracao_v2 SELECT * FROM events ORDER BY rowid"
+        )
+        conn.execute("DROP TABLE events")
+        conn.execute("ALTER TABLE events_migracao_v2 RENAME TO events")
+
+    if not _tabela_existe(conn, "cumprimentos"):
+        conn.execute(
+            "CREATE TABLE cumprimentos("
+            "id INTEGER PRIMARY KEY AUTOINCREMENT,"
+            " conversation_id INTEGER, message_id INTEGER,"
+            " texto TEXT, variante INTEGER, enviado_em TEXT,"
+            " inbox_id INTEGER NOT NULL,"
+            " UNIQUE(inbox_id, message_id))"
+        )
+    elif ("inbox_id" not in _colunas(conn, "cumprimentos")
+          or not _tem_unicidade_por_inbox(conn, "cumprimentos")):
+        antigos = conn.execute(
+            "SELECT id, conversation_id, message_id, texto, variante, enviado_em"
+            " FROM cumprimentos ORDER BY id"
+        ).fetchall()
+        migrados = []
+        for row in antigos:
+            inbox_id = _inbox_unico_do_evento(conn, row[2])
+            migrados.append((*row, inbox_id))
+        conn.execute(
+            "CREATE TABLE cumprimentos_migracao_v2("
+            "id INTEGER PRIMARY KEY AUTOINCREMENT,"
+            " conversation_id INTEGER, message_id INTEGER,"
+            " texto TEXT, variante INTEGER, enviado_em TEXT,"
+            " inbox_id INTEGER NOT NULL,"
+            " UNIQUE(inbox_id, message_id))"
+        )
+        conn.executemany(
+            "INSERT INTO cumprimentos_migracao_v2"
+            "(id, conversation_id, message_id, texto, variante, enviado_em, inbox_id)"
+            " VALUES (?, ?, ?, ?, ?, ?, ?)",
+            migrados,
+        )
+        conn.execute("DROP TABLE cumprimentos")
+        conn.execute("ALTER TABLE cumprimentos_migracao_v2 RENAME TO cumprimentos")
+    conn.execute("PRAGMA user_version=2")
+
